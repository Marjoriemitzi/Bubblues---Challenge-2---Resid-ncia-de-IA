# Configuracoes do PostgreSQL/PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pipeline_brasilia
DB_USER=postgres
DB_PASSWORD=coloque_sua_senha_aqui

# Langfuse (tracing opcional: sem as chaves, nada e enviado)
# Chaves em Langfuse > Settings > API Keys. Nunca versione o .env.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# us.cloud.langfuse.com para a regiao US; ou a URL do seu Langfuse self-hosted
LANGFUSE_TRACING_ENVIRONMENT=development
