TAVILY_API_KEY=tvly-sua_chave_aqui
LLM_API_KEY=sua_chave_llm_aqui

# --- LLM do orquestrador (NLU e, depois, o agente de Retrieval): DeepSeek ---
DEEPSEEK_API_KEY=coloque_sua_chave_aqui
# Opcionais (os padroes ja sao os recomendados):
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_REASONING_EFFORT=none   # none | low | high | max (thinking custa ~2x tokens de saida e mais latencia)
# DEEPSEEK_STRICT=1                # endpoint /beta: o modelo segue o JSON Schema das tools (mais rapido no teste)

# --- Retrieval ---
# RETRIEVAL_MODE=llm   # llm (agente DeepSeek com fallback para o pipeline, padrao) | deterministic (so o pipeline, sem LLM)

# --- Langfuse (experimentos e tracing) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=false  # desliga o tracing mesmo com as chaves
# LANGFUSE_LOG_CONTENT=1          # SO depuracao: grava o conteudo das mensagens ao LLM (inclui o texto livre do usuario; RNF02)
